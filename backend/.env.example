# Copiar a backend/.env y llenar. backend/.env NUNCA se sube al repo.

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
# Llave anon (o "publishable" en proyectos nuevos). La usa el adaptador para las apps.
SUPABASE_ANON_KEY=
# Llave service_role (o "secret"). Solo el suscriptor; nunca en un front.
SUPABASE_SERVICE_ROLE_KEY=
# Connect -> "Session pooler" (para psql y pg_dump). Incluye la contraseña de la BD.
SUPABASE_DB_URL=

# --- PostgreSQL local (pruebas SQL y restauración del respaldo) ---
LOCAL_DB_URL=postgresql://postgres:CAMBIA_ESTO@localhost:5432/postgres
PG_BIN=C:\Program Files\PostgreSQL\18\bin

# --- MQTT (lo define Conectividad) ---
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_TELEMETRIA=invernadero/albahaca_01/telemetria
BUFFER_PATH=./buffer/pendientes.jsonl

# --- Adaptador REST para las apps (puerto que esperan app web y móvil) ---
PORT=3000
# Cuentas de equipo (las crea `npm run usuarios`, que llena estos valores).
# Aplicación (rol OPERADOR): la usa el adaptador.
APP_EMAIL=
APP_PASSWORD=
AUTOMATIZACION_EMAIL=
AUTOMATIZACION_PASSWORD=
CONECTIVIDAD_EMAIL=
CONECTIVIDAD_PASSWORD=
HARDWARE_EMAIL=
HARDWARE_PASSWORD=
# Cuenta de solo lectura para las pruebas de permisos.
LECTOR_EMAIL=
LECTOR_PASSWORD=

# --- Solo para scripts/configurar_supabase.js (se pueden borrar después) ---
# Token personal: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Contraseña de la BD que pusiste al crear el proyecto
SUPABASE_DB_PASSWORD=
